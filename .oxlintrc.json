{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "warn",
        "nursery": "warn",
        "perf": "warn",
        "suspicious": "warn"
    },
    "options": {
        "typeAware": true,
        "typeCheck": true
    },
    "plugins": ["eslint", "jsdoc", "oxc", "typescript", "unicorn"],
    "overrides": [
        {
            "files": ["packages/*/src/**"],
            "rules": {
                "no-restricted-imports": [
                    "warn",
                    {
                        "patterns": [
                            {
                                "group": ["./*", "../*"],
                                "message": "Use the `#/` subpath alias instead of relative imports."
                            },
                            {
                                "group": ["#/core/index", "#/feature/index"],
                                "message": "Import the module that defines the name - barrels are for package entry points."
                            }
                        ]
                    }
                ]
            }
        }
    ],
    "rules": {
        "typescript/no-floating-promises": [
            "warn",
            {
                "allowForKnownSafeCalls": [
                    {
                        "from": "package",
                        "package": "node:test",
                        "name": ["describe", "it", "suite", "test"]
                    }
                ]
            }
        ],
        "no-shadow": "off",
        "no-underscore-dangle": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/custom-error-definition": ["warn"],
        "unicorn/filename-case": [
            "warn",
            {
                "case": "snakeCase"
            }
        ]
    }
}
