{
    "format_on_save": "on",
    "prettier": {
        "allowed": false
    },
    "lsp": {
        "typescript-ls": {
            "settings": {
                "package_version": "7.0.2"
            }
        },
        "oxlint": {
            "initialization_options": {
                "settings": {
                    "disableNestedConfig": true
                }
            }
        },
        "oxfmt": {
            "initialization_options": {
                "settings": {
                    "fmt.disableNestedConfig": true
                }
            }
        }
    },
    "languages": {
        "TypeScript": {
            "language_servers": ["typescript-ls", "oxlint", "oxfmt"],
            "formatter": [
                { "code_action": "source.fixAll.oxc" },
                { "language_server": { "name": "oxfmt" } }
            ]
        },
        "JavaScript": {
            "language_servers": ["typescript-ls", "oxlint", "oxfmt"],
            "formatter": [
                { "code_action": "source.fixAll.oxc" },
                { "language_server": { "name": "oxfmt" } }
            ]
        },
        "JSON": {
            "language_servers": ["json-language-server", "oxfmt"],
            "formatter": { "language_server": { "name": "oxfmt" } }
        },
        "JSONC": {
            "language_servers": ["json-language-server", "oxfmt"],
            "formatter": { "language_server": { "name": "oxfmt" } }
        },
        "YAML": {
            "language_servers": ["oxfmt", "..."],
            "formatter": { "language_server": { "name": "oxfmt" } }
        },
        "Markdown": {
            "language_servers": ["oxfmt", "..."],
            "formatter": { "language_server": { "name": "oxfmt" } }
        },
        "TOML": {
            "language_servers": ["oxfmt", "..."],
            "formatter": { "language_server": { "name": "oxfmt" } }
        }
    }
}
