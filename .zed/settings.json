{
    "lsp": {
        "typescript-ls": {
            "settings": {
                "package_version": "7.0.2"
            }
        }
    },
    "languages": {
        "TypeScript": {
            "format_on_save": "on",
            "language_servers": ["typescript-ls", "oxlint", "oxfmt"],
            "formatter": [
                { "code_action": "source.fixAll.oxc" },
                { "language_server": { "name": "oxfmt" } }
            ]
        },
        "JavaScript": {
            "format_on_save": "on",
            "language_servers": ["typescript-ls", "oxlint", "oxfmt"],
            "formatter": [
                { "code_action": "source.fixAll.oxc" },
                { "language_server": { "name": "oxfmt" } }
            ]
        },
        "JSON": {
            "format_on_save": "on",
            "formatter": { "language_server": { "name": "oxfmt" } }
        },
        "JSONC": {
            "format_on_save": "on",
            "formatter": { "language_server": { "name": "oxfmt" } }
        },
        "YAML": {
            "format_on_save": "on",
            "formatter": { "language_server": { "name": "oxfmt" } }
        },
        "Markdown": {
            "format_on_save": "on",
            "formatter": { "language_server": { "name": "oxfmt" } }
        }
    }
}
