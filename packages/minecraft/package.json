{
    "name": "@bedfox/minecraft",
    "version": "1.26.70-preview.22",
    "description": "Minecraft Bedrock Add-On data for Bedfox",
    "homepage": "https://github.com/arexon/bedfox#readme",
    "bugs": {
        "url": "https://github.com/arexon/bedfox/issues"
    },
    "license": "Apache-2.0",
    "author": "arexon <me@arexon.dev>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arexon/bedfox.git",
        "directory": "packages/minecraft"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "imports": {
        "#package.json": "./package.json",
        "#/*": "./src/*.ts"
    },
    "exports": {
        "./block": "./src/block/index.ts",
        "./component": "./src/component/index.ts",
        "./definition": "./src/definition/index.ts",
        "./feature": "./src/feature/index.ts",
        "./manifest": "./src/manifest/index.ts",
        "./plugins": "./src/plugins/index.ts",
        "./primitive": "./src/primitive/index.ts",
        "./query": "./src/query/index.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "exports": {
            "./block": "./dist/block/index.mjs",
            "./component": "./dist/component/index.mjs",
            "./definition": "./dist/definition/index.mjs",
            "./feature": "./dist/feature/index.mjs",
            "./manifest": "./dist/manifest/index.mjs",
            "./plugins": "./dist/plugins/index.mjs",
            "./primitive": "./dist/primitive/index.mjs",
            "./query": "./dist/query/index.mjs",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "prepublishOnly": "pnpm -w build"
    },
    "devDependencies": {
        "@bedfox/core": "workspace:*"
    },
    "peerDependencies": {
        "@bedfox/core": "workspace:^"
    }
}
