{
    "name": "@bedfox/api",
    "version": "1.0.0",
    "description": "Cute and programmatic MCBE Add-On framework for TypeScript",
    "homepage": "https://github.com/arexon/bedfox#readme",
    "bugs": {
        "url": "https://github.com/arexon/bedfox/issues"
    },
    "license": "MIT",
    "author": "arexon <me@arexon.dev>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arexon/bedfox.git",
        "directory": "packages/api"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "imports": {
        "#/*": "./src/*.ts"
    },
    "exports": {
        "./block": "./dist/block/index.mjs",
        "./common": "./dist/common/index.mjs",
        "./feature": "./dist/feature/index.mjs",
        "./molang": "./dist/molang.mjs",
        "./registry": "./dist/registry.mjs",
        "./version": "./dist/version.mjs",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "test": "vp test",
        "check": "vp check",
        "prepublishOnly": "vp run build"
    },
    "dependencies": {
        "@bedfox/serialize": "workspace:^"
    }
}
