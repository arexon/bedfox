{
    "name": "@bedfox/core",
    "version": "1.0.0",
    "description": "Comfy and programmatic MCBE Add-On framework for TypeScript",
    "homepage": "https://github.com/arexon/bedfox#readme",
    "bugs": {
        "url": "https://github.com/arexon/bedfox/issues"
    },
    "license": "Apache-2.0",
    "author": "arexon <me@arexon.dev>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arexon/bedfox.git",
        "directory": "packages/core"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "imports": {
        "#/*": "./src/*.ts"
    },
    "exports": {
        ".": "./src/index.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "exports": {
            ".": "./dist/index.mjs",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "prepublishOnly": "pnpm -w build"
    }
}
